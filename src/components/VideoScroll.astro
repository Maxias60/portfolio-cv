<div class="field-scroll">
  <slot />
</div>

<style>
  .field-scroll {
    display: flex;
    gap: 18px;

    overflow-x: auto;

    padding: 6px 6px 20px;

    margin: 0 -6px;

    scroll-snap-type: x proximity;
  }

  .field-scroll :global(.field-card) {
    flex: 0 0 auto;

    width: min(78vw, 300px);

    margin: 0;

    scroll-snap-align: start;

    background: var(--global-card-bg-color);

    border: 1px solid var(--global-divider-color);

    border-radius: 6px;

    overflow: hidden;
  }

  .field-scroll :global(.field-card video) {
    width: 100%;

    aspect-ratio: 9 / 16;

    object-fit: cover;

    background: #000;

    display: block;
  }

  .field-scroll :global(.field-card figcaption) {
    padding: 14px 16px 18px;

    font-size: 0.84rem;

    color: var(--global-text-color-light);
  }

  .field-scroll :global(.field-card.is-landscape) {
    width: min(90vw, 460px);
  }

  .field-scroll :global(.field-card.is-landscape video) {
    aspect-ratio: 16 / 9;
  }
</style>

<script>
  function initScrollableVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>(
      '.field-scroll video[data-autoplay]',
    );

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;

          if (entry.isIntersecting) {
            const playPromise = video.play();

            playPromise?.catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      {
        threshold: 0.35,
      },
    );

    videos.forEach((video) => {
      observer.observe(video);
    });
  }

  document.addEventListener('astro:page-load', initScrollableVideos);
</script>
