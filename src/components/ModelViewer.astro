---
interface Props {
  src: string;
  alt?: string;
  height?: string;
}

const { src, alt = '3D model', height = '400px' } = Astro.props;

const modelPath = src.startsWith('http') ? src : `${import.meta.env.BASE_URL}${src}`;
---

<script
  type="module"
  src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"
  is:inline></script>

<div class="model-viewer-wrapper">
  <model-viewer src={modelPath} alt={alt} ar camera-controls auto-rotate touch-action="pan-y">
  </model-viewer>
</div>

<style define:vars={{ height }}>
  .model-viewer-wrapper {
    width: 100%;
    height: var(--height);
    margin: 2rem 0;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  model-viewer {
    width: 100%;
    height: 100%;
  }
</style>
