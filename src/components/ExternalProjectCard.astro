---
import { withBase } from '@utils/base';

interface Props {
  title: string;
  description?: string;
  img?: string;
  imgAlt?: string;
  href: string;
  imgFit?: 'cover' | 'contain';
  imgPadding?: string;
}

const { title, description, img, imgAlt, href, imgFit = 'cover', imgPadding = '0' } = Astro.props;
---

<div class="external-project-card-wrapper">
  <div class="card hoverable h-100" data-href={href}>
    {
      img && (
        <a href={href} target="_blank" rel="noopener noreferrer" class="card-image-link">
          <img
            src={withBase(img)}
            alt={imgAlt ?? title}
            loading="lazy"
            width="400"
            height="200"
            class="card-img-top no-zoom"
            style={`object-fit: ${imgFit}; padding: ${imgPadding};`}
          />
        </a>
      )
    }

    <div class="card-body">
      <h2 class="card-title">
        <a href={href} target="_blank" rel="noopener noreferrer" class="card-title-link">
          {title}
        </a>
      </h2>

      {description && <p class="card-text">{description}</p>}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.external-project-card-wrapper .card').forEach((card) => {
    card.addEventListener('click', (event) => {
      const target = event.target;

      if (target instanceof HTMLElement && target.closest('a')) {
        return;
      }

      const href = card.getAttribute('data-href');

      if (href) {
        window.open(href, '_blank', 'noopener,noreferrer');
      }
    });
  });
</script>

<style>
  .external-project-card-wrapper {
    width: 100%;
    max-width: none;
    margin: 0;
    height: 100%;
  }

  .card {
    border: 1px solid var(--global-divider-color);
    border-radius: 4px;
    background-color: var(--global-card-bg-color);
    overflow: hidden;

    display: flex;
    flex-direction: column;

    cursor: pointer;
  }

  .h-100 {
    height: 100%;
  }

  .hoverable {
    transition: box-shadow 0.25s ease;
  }

  .hoverable:hover {
    box-shadow:
      0 5px 11px 0 rgba(0, 0, 0, 0.18),
      0 4px 15px 0 rgba(0, 0, 0, 0.15);
  }

  :global(html[data-theme='dark']) .hoverable:hover {
    box-shadow:
      0 5px 11px 0 rgba(255, 255, 255, 0.18),
      0 4px 15px 0 rgba(255, 255, 255, 0.15);
  }

  .card-img-top {
    width: 100%;
    height: 200px;
    display: block;
    object-fit: cover;
  }

  .card-body {
    padding: 1.25rem;
    flex: 1;

    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;

    margin: 0 0 0.5rem;

    font-family: var(--font-sans);
  }

  .card-title-link {
    color: var(--global-text-color);
    text-decoration: none;

    transition: color 0.15s ease;
  }

  .card:hover .card-title-link {
    color: var(--global-theme-color);
  }

  .card-text {
    color: var(--global-text-color-light);

    font-size: 0.875rem;

    margin: 0;
    flex: 1;
  }

  .card-image-link {
    display: block;
    text-decoration: none;
  }

  .card-image-link img {
    display: block;
    width: 100%;
  }
</style>
