---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="project-toc-desktop" aria-label="Project contents">
  <a href="#project-title" class="toc-project-title" data-heading-id="project-title">
    {title}
  </a>

  <nav>
    <ul class="toc-list"></ul>
  </nav>
</aside>

<nav class="project-toc-mobile" aria-label="Project progress">
  <div class="mobile-toc-track">
    <div class="mobile-toc-dots"></div>

    <div class="mobile-position-handle">
      <span class="position-arrowhead position-arrowhead-up" aria-hidden="true"></span>

      <button
        type="button"
        class="mobile-page-position"
        aria-label="Open or drag project navigation"></button>

      <span class="position-arrowhead position-arrowhead-down" aria-hidden="true"></span>
    </div>
  </div>
</nav>

<div class="mobile-toc-backdrop" aria-hidden="true"></div>
<div class="mobile-drag-capture" aria-hidden="true"></div>

<aside class="mobile-toc-menu" aria-label="Project navigation" aria-hidden="true">
  <div class="mobile-toc-menu-inner">
    <button type="button" class="mobile-toc-menu-title" data-mobile-menu-heading-id="project-title">
      {title}
    </button>

    <nav>
      <ul class="mobile-menu-list"></ul>
    </nav>
  </div>
</aside>

<script>
  interface TocNode {
    id: string;
    text: string;
    level: number;
    children: TocNode[];
  }

  interface HeadingInfo {
    element: HTMLElement;
    id: string;
    level: number;
  }

  function initProjectToc() {
    const desktopToc = document.querySelector<HTMLElement>('.project-toc-desktop');
    const desktopList = desktopToc?.querySelector<HTMLUListElement>('.toc-list');
    const desktopTitle = desktopToc?.querySelector<HTMLAnchorElement>('.toc-project-title');

    const mobileToc = document.querySelector<HTMLElement>('.project-toc-mobile');
    const mobileTrack = mobileToc?.querySelector<HTMLElement>('.mobile-toc-track');
    const mobileDots = mobileToc?.querySelector<HTMLElement>('.mobile-toc-dots');
    const mobilePositionHandle = mobileToc?.querySelector<HTMLElement>('.mobile-position-handle');
    const mobilePagePosition = mobileToc?.querySelector<HTMLButtonElement>('.mobile-page-position');

    const mobileMenu = document.querySelector<HTMLElement>('.mobile-toc-menu');
    const mobileMenuList = mobileMenu?.querySelector<HTMLUListElement>('.mobile-menu-list');
    const mobileMenuTitle = mobileMenu?.querySelector<HTMLButtonElement>('.mobile-toc-menu-title');

    const mobileBackdrop = document.querySelector<HTMLElement>('.mobile-toc-backdrop');
    const mobileDragCapture = document.querySelector<HTMLElement>('.mobile-drag-capture');

    const content = document.querySelector<HTMLElement>('#project-content');
    const projectTitleElement = document.querySelector<HTMLElement>('#project-title');

    if (
      !desktopToc ||
      !desktopList ||
      !desktopTitle ||
      !mobileToc ||
      !mobileTrack ||
      !mobileDots ||
      !mobilePositionHandle ||
      !mobilePagePosition ||
      !mobileMenu ||
      !mobileMenuList ||
      !mobileMenuTitle ||
      !mobileBackdrop ||
      !mobileDragCapture ||
      !content
    ) {
      return;
    }

    const track = mobileTrack;
    const dots = mobileDots;
    const positionHandle = mobilePositionHandle;
    const positionButton = mobilePagePosition;
    const menu = mobileMenu;
    const menuList = mobileMenuList;
    const menuTitle = mobileMenuTitle;
    const backdrop = mobileBackdrop;
    const dragCapture = mobileDragCapture;
    const projectContent = content;

    desktopList.innerHTML = '';
    dots.innerHTML = '';
    menuList.innerHTML = '';

    const contentHeadings = Array.from(projectContent.querySelectorAll<HTMLElement>('h1,h2,h3,h4'));

    contentHeadings.forEach((heading, index) => {
      if (!heading.id) {
        heading.id = `project-section-${index + 1}`;
      }
    });

    const headingInfos: HeadingInfo[] = [];

    if (projectTitleElement) {
      headingInfos.push({
        element: projectTitleElement,
        id: projectTitleElement.id,
        level: 1,
      });
    }

    contentHeadings.forEach((heading) => {
      headingInfos.push({
        element: heading,
        id: heading.id,
        level: Number(heading.tagName.substring(1)),
      });
    });

    if (headingInfos.length === 0) {
      return;
    }

    function isCardHeading(id: string) {
      const heading = document.getElementById(id);

      return heading?.classList.contains('card-title') ?? false;
    }

    const tree: TocNode[] = [];
    const stack: Array<{ level: number; children: TocNode[] }> = [{ level: 0, children: tree }];

    contentHeadings.forEach((heading) => {
      const level = Number(heading.tagName.substring(1));

      const node: TocNode = {
        id: heading.id,
        text: heading.textContent?.trim() ?? '',
        level,
        children: [],
      };

      while (stack.length > 1 && level <= stack[stack.length - 1].level) {
        stack.pop();
      }

      stack[stack.length - 1].children.push(node);
      stack.push({ level, children: node.children });
    });

    function renderDesktopTree(nodes: TocNode[], parent: HTMLUListElement) {
      nodes.forEach((node) => {
        const item = document.createElement('li');

        item.classList.add('toc-item', `toc-level-${node.level}`);

        if (isCardHeading(node.id)) {
          item.classList.add('toc-card-item');
        }

        const link = document.createElement('a');
        link.href = `#${node.id}`;
        link.textContent = node.text;
        link.dataset.headingId = node.id;

        item.appendChild(link);

        if (node.children.length > 0) {
          const children = document.createElement('ul');
          children.classList.add('toc-children');

          renderDesktopTree(node.children, children);
          item.appendChild(children);
        }

        parent.appendChild(item);
      });
    }

    renderDesktopTree(tree, desktopList);

    function renderMobileTree(nodes: TocNode[], parent: HTMLUListElement) {
      nodes.forEach((node) => {
        const item = document.createElement('li');

        item.classList.add('mobile-menu-item', `mobile-menu-level-${node.level}`);

        if (isCardHeading(node.id)) {
          item.classList.add('mobile-menu-card-item');
        }

        const link = document.createElement('a');
        link.href = `#${node.id}`;
        link.textContent = node.text;
        link.dataset.mobileMenuHeadingId = node.id;

        link.addEventListener('click', (event) => {
          event.preventDefault();
          navigateMobileTo(node.id);
        });

        item.appendChild(link);

        if (node.children.length > 0) {
          const children = document.createElement('ul');
          children.classList.add('mobile-menu-children');

          renderMobileTree(node.children, children);
          item.appendChild(children);
        }

        parent.appendChild(item);
      });
    }

    renderMobileTree(tree, menuList);

    const mobileDotMap = new Map<string, HTMLButtonElement>();

    headingInfos.forEach((heading) => {
      const marker = document.createElement('button');

      marker.type = 'button';
      marker.classList.add('mobile-heading-dot', `mobile-level-${heading.level}`);
      marker.dataset.headingId = heading.id;
      marker.setAttribute('aria-label', 'Jump to section');

      marker.addEventListener('click', () => {
        navigateMobileTo(heading.id);
      });

      dots.appendChild(marker);
      mobileDotMap.set(heading.id, marker);
    });

    const desktopLinks = Array.from(
      desktopToc.querySelectorAll<HTMLAnchorElement>('[data-heading-id]'),
    );

    const mobileMenuLinks = Array.from(
      menu.querySelectorAll<HTMLAnchorElement>('[data-mobile-menu-heading-id]'),
    );

    let lastHeadingMarkerY = 0;

    function getMobileRailMetrics() {
      const padding = 8;

      return {
        padding,
        usableHeight: Math.max(track.clientHeight - padding * 2, 1),
      };
    }

    function getDocumentRange() {
      const firstHeading = headingInfos[0];

      if (!firstHeading) {
        return null;
      }

      const firstY = firstHeading.element.getBoundingClientRect().top + window.scrollY;

      const contentBottom = projectContent.getBoundingClientRect().bottom + window.scrollY;

      return {
        firstY,
        totalRange: Math.max(contentBottom - firstY, 1),
      };
    }

    function progressToRailY(progress: number) {
      const metrics = getMobileRailMetrics();

      return metrics.padding + progress * metrics.usableHeight;
    }

    function railYToProgress(y: number) {
      const metrics = getMobileRailMetrics();

      return Math.min(1, Math.max(0, (y - metrics.padding) / metrics.usableHeight));
    }

    function updateMobileHeadingDots() {
      const range = getDocumentRange();

      if (!range) {
        return;
      }

      let lastMarkerY = getMobileRailMetrics().padding;

      headingInfos.forEach((heading) => {
        const headingY = heading.element.getBoundingClientRect().top + window.scrollY;

        const progress = Math.min(1, Math.max(0, (headingY - range.firstY) / range.totalRange));

        const marker = mobileDotMap.get(heading.id);

        if (!marker) {
          return;
        }

        const railY = progressToRailY(progress);

        marker.style.top = `${railY}px`;

        lastMarkerY = Math.max(lastMarkerY, railY);
      });

      lastHeadingMarkerY = lastMarkerY;

      track.style.setProperty('--mobile-rail-end', `${lastHeadingMarkerY}px`);
    }

    function getMobileReferenceOffset() {
      const firstHeading = headingInfos[0];

      if (!firstHeading) {
        return 75;
      }

      const value = parseFloat(getComputedStyle(firstHeading.element).scrollMarginTop);

      return Number.isFinite(value) ? value : 75;
    }

    function getVisibleHeadingIds(topOffset: number) {
      const ids = new Set<string>();

      headingInfos.forEach((heading) => {
        const rect = heading.element.getBoundingClientRect();

        const visible = rect.bottom > topOffset && rect.top < window.innerHeight;

        if (visible) {
          ids.add(heading.id);
        }
      });

      return ids;
    }

    function getTopVisibleHeadingId(topOffset: number) {
      for (const heading of headingInfos) {
        const rect = heading.element.getBoundingClientRect();

        const visible = rect.bottom > topOffset && rect.top < window.innerHeight;

        if (visible) {
          return heading.id;
        }
      }

      return null;
    }

    function setDesktopHeadingStates(visibleIds: Set<string>, activeId: string | null) {
      desktopLinks.forEach((link) => {
        const id = link.dataset.headingId;

        const isVisible = typeof id === 'string' && visibleIds.has(id);

        const isActive = typeof id === 'string' && id === activeId;

        link.classList.toggle('visible', isVisible);
        link.classList.toggle('active', isActive);

        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    function setMobileHeadingStates(visibleIds: Set<string>, activeId: string | null) {
      mobileDotMap.forEach((marker, markerId) => {
        marker.classList.toggle('visible', visibleIds.has(markerId));
        marker.classList.toggle('active', markerId === activeId);
      });

      mobileMenuLinks.forEach((link) => {
        const id = link.dataset.mobileMenuHeadingId;

        const isVisible = typeof id === 'string' && visibleIds.has(id);

        const isActive = typeof id === 'string' && id === activeId;

        link.classList.toggle('visible', isVisible);
        link.classList.toggle('active', isActive);
      });

      menuTitle.classList.toggle('visible', visibleIds.has('project-title'));

      menuTitle.classList.toggle('active', activeId === 'project-title');
    }

    let menuPinnedOpen = false;

    function setMenuOpen(open: boolean) {
      menu.classList.toggle('open', open);
      backdrop.classList.toggle('open', open);
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
    }

    let mobileNavigationTargetId: string | null = null;
    let mobileNavigationTimeout: number | null = null;

    function clearMobileNavigationLock() {
      mobileNavigationTargetId = null;

      if (mobileNavigationTimeout !== null) {
        window.clearTimeout(mobileNavigationTimeout);
        mobileNavigationTimeout = null;
      }
    }

    function navigateMobileTo(id: string) {
      const target = document.getElementById(id);

      if (!target) {
        return;
      }

      mobileNavigationTargetId = id;

      const visibleNow = getVisibleHeadingIds(getMobileReferenceOffset());

      visibleNow.add(id);

      setMobileHeadingStates(visibleNow, id);

      menuPinnedOpen = false;
      setMenuOpen(false);

      target.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });

      if (mobileNavigationTimeout !== null) {
        window.clearTimeout(mobileNavigationTimeout);
      }

      mobileNavigationTimeout = window.setTimeout(() => {
        clearMobileNavigationLock();
        updateToc();
      }, 1600);
    }

    menuTitle.addEventListener('click', () => {
      navigateMobileTo('project-title');
    });

    function updateMobilePagePosition() {
      const range = getDocumentRange();

      if (!range) {
        return;
      }

      const readingY = window.scrollY + getMobileReferenceOffset();

      const progress = Math.min(1, Math.max(0, (readingY - range.firstY) / range.totalRange));

      const positionY = progressToRailY(progress);

      positionHandle.style.top = `${positionY}px`;

      const railEnd = Math.max(lastHeadingMarkerY, positionY);

      track.style.setProperty('--mobile-rail-end', `${railEnd}px`);
    }

    let backdropPointerStartY = 0;
    let backdropPointerMoved = false;

    backdrop.addEventListener('pointerdown', (event) => {
      backdropPointerStartY = event.clientY;
      backdropPointerMoved = false;
    });

    backdrop.addEventListener('pointermove', (event) => {
      if (Math.abs(event.clientY - backdropPointerStartY) > 8) {
        backdropPointerMoved = true;
      }
    });

    backdrop.addEventListener('pointerup', () => {
      if (backdropPointerMoved) {
        return;
      }

      menuPinnedOpen = false;
      setMenuOpen(false);
    });

    let dragging = false;
    let activePointerId: number | null = null;
    let pointerStartY = 0;
    let pointerMoved = false;

    const dragThreshold = 6;

    function updateDrag(clientY: number) {
      clearMobileNavigationLock();

      const trackRect = track.getBoundingClientRect();

      const localY = Math.min(trackRect.height, Math.max(0, clientY - trackRect.top));

      const progress = railYToProgress(localY);
      const range = getDocumentRange();

      if (!range) {
        return;
      }

      const targetReadingY = range.firstY + progress * range.totalRange;

      const targetScrollY = targetReadingY - getMobileReferenceOffset();

      const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

      const clamped = Math.min(maxScroll, Math.max(0, targetScrollY));

      window.scrollTo(0, clamped);

      const positionY = progressToRailY(progress);

      positionHandle.style.top = `${positionY}px`;

      track.style.setProperty('--mobile-rail-end', `${Math.max(lastHeadingMarkerY, positionY)}px`);

      const visible = getVisibleHeadingIds(getMobileReferenceOffset());

      const active = getTopVisibleHeadingId(getMobileReferenceOffset());

      setMobileHeadingStates(visible, active);
    }

    function startDrag(event: PointerEvent) {
      activePointerId = event.pointerId;
      pointerStartY = event.clientY;
      pointerMoved = false;
      dragging = false;

      positionButton.setPointerCapture(event.pointerId);

      event.preventDefault();
    }

    function moveDrag(event: PointerEvent) {
      if (activePointerId !== event.pointerId) {
        return;
      }

      const distance = Math.abs(event.clientY - pointerStartY);

      if (!dragging && distance >= dragThreshold) {
        dragging = true;
        pointerMoved = true;

        document.documentElement.classList.add('toc-dragging');

        document.body.classList.add('toc-dragging');

        dragCapture.classList.add('active');

        setMenuOpen(true);
      }

      if (dragging) {
        updateDrag(event.clientY);
      }

      event.preventDefault();
    }

    function finishDrag(event: PointerEvent) {
      if (activePointerId !== event.pointerId) {
        return;
      }

      if (positionButton.hasPointerCapture(event.pointerId)) {
        positionButton.releasePointerCapture(event.pointerId);
      }

      if (!pointerMoved) {
        menuPinnedOpen = !menuPinnedOpen;
        setMenuOpen(menuPinnedOpen);
      }

      if (dragging && !menuPinnedOpen) {
        window.setTimeout(() => {
          setMenuOpen(false);
        }, 300);
      }

      document.documentElement.classList.remove('toc-dragging');

      document.body.classList.remove('toc-dragging');

      dragCapture.classList.remove('active');

      dragging = false;
      pointerMoved = false;
      activePointerId = null;
    }

    positionButton.addEventListener('pointerdown', startDrag);

    positionButton.addEventListener('pointermove', moveDrag);

    positionButton.addEventListener('pointerup', finishDrag);

    positionButton.addEventListener('pointercancel', finishDrag);

    function updateToc() {
      const desktopOffset = 75;

      const desktopVisible = getVisibleHeadingIds(desktopOffset);

      const desktopActive = getTopVisibleHeadingId(desktopOffset);

      setDesktopHeadingStates(desktopVisible, desktopActive);

      const mobileOffset = getMobileReferenceOffset();

      const mobileVisible = getVisibleHeadingIds(mobileOffset);

      let mobileActive = getTopVisibleHeadingId(mobileOffset);

      if (mobileNavigationTargetId) {
        mobileVisible.add(mobileNavigationTargetId);

        const targetHeading = headingInfos.find(
          (heading) => heading.id === mobileNavigationTargetId,
        );

        if (targetHeading) {
          const rect = targetHeading.element.getBoundingClientRect();

          mobileActive = mobileNavigationTargetId;

          if (Math.abs(rect.top - mobileOffset) <= 8) {
            clearMobileNavigationLock();
          }
        } else {
          clearMobileNavigationLock();
        }
      }

      setMobileHeadingStates(mobileVisible, mobileActive);

      if (!dragging) {
        updateMobilePagePosition();
      }
    }

    updateMobileHeadingDots();
    updateToc();

    window.addEventListener('resize', () => {
      updateMobileHeadingDots();
      updateToc();
    });

    window.addEventListener('scroll', updateToc, {
      passive: true,
    });

    window.addEventListener(
      'load',
      () => {
        updateMobileHeadingDots();
        updateToc();
      },
      {
        once: true,
      },
    );
  }

  document.addEventListener('astro:page-load', initProjectToc);
</script>

<style>
  .project-toc-desktop {
    width: 240px;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    scrollbar-width: thin;
  }

  .toc-project-title,
  :global(.toc-card-item > a) {
    display: block;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 7px;
    background: var(--global-card-bg-color);
    color: var(--global-text-color) !important;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none !important;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .toc-project-title {
    margin-bottom: 0.75rem;
  }

  :global(.toc-card-item) {
    position: relative;
    margin-top: 0.35rem;
  }

  .toc-project-title:hover,
  :global(.toc-card-item > a:hover) {
    color: var(--global-theme-color) !important;
    border-color: var(--global-theme-color);
  }

  .toc-project-title.active,
  :global(.toc-card-item > a.active) {
    color: var(--global-theme-color) !important;
    border-color: var(--global-theme-color);
    background: color-mix(in srgb, var(--global-theme-color) 12%, var(--global-card-bg-color));
  }

  /* Desktop project cards: visible = accent bar, active = bar + existing active styling */
  :global(.toc-card-item > a) {
    position: relative;
  }

  :global(.toc-card-item > a.visible::before),
  :global(.toc-card-item > a.active::before) {
    content: '';
    position: absolute;
    left: -1px;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 3px;
    border-radius: 3px;
    background: var(--global-theme-color);
    z-index: 1;
  }

  :global(.toc-list),
  :global(.toc-children) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.toc-item) {
    position: relative;
    margin: 0;
    padding: 0;
  }

  :global(.toc-item:not(.toc-card-item) > a) {
    position: relative;
    display: block;
    padding: 0.34rem 0.55rem;
    border-radius: 5px;
    color: var(--global-text-color) !important;
    text-decoration: none !important;
    line-height: 1.35;
  }

  :global(.toc-children) {
    position: relative;
    margin-left: 0.7rem;
    padding-left: 0.8rem;
    border-left: 1px solid var(--global-divider-color);
  }

  :global(.toc-children > .toc-item::before) {
    content: '';
    position: absolute;
    top: 1rem;
    left: -0.8rem;
    width: 0.55rem;
    border-top: 1px solid var(--global-divider-color);
  }

  :global(.toc-children > .toc-item:last-child::after) {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 1.05rem;
    bottom: 0;
    width: 2px;
    background: var(--global-bg-color);
  }

  :global(.toc-level-1 > a) {
    font-weight: 600;
  }

  :global(.toc-level-2 > a) {
    font-weight: 500;
  }

  :global(.toc-level-3 > a) {
    font-size: 0.84rem;
  }

  :global(.toc-level-4 > a) {
    font-size: 0.8rem;
  }

  /* all visible headings: accent bar only */
  :global(.toc-item:not(.toc-card-item) > a.visible::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    bottom: 0.3rem;
    width: 3px;
    border-radius: 3px;
    background: var(--global-theme-color);
  }

  /* topmost visible heading: background + text + bar */
  :global(.toc-item:not(.toc-card-item) > a.active) {
    color: var(--global-theme-color) !important;
    background: color-mix(in srgb, var(--global-theme-color) 10%, transparent);
    font-weight: 600;
  }

  :global(.toc-item:not(.toc-card-item) > a.active::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    bottom: 0.3rem;
    width: 3px;
    border-radius: 3px;
    background: var(--global-theme-color);
  }

  .project-toc-mobile,
  .mobile-toc-menu,
  .mobile-toc-backdrop,
  .mobile-drag-capture {
    display: none;
  }

  @media (max-width: 1350px) {
    .project-toc-desktop {
      display: none;
    }

    .mobile-toc-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 14;
      background: rgba(0, 0, 0, 0.08);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      opacity: 0;
      pointer-events: none;
      touch-action: pan-y;
      transition: opacity 0.18s ease;
    }

    .mobile-toc-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .project-toc-mobile {
      display: block;
      position: fixed;
      right: 0;
      left: auto;
      top: 5.5rem;
      bottom: 0.75rem;
      width: 24px;
      z-index: 18;
      pointer-events: none;
    }

    .mobile-toc-track {
      position: absolute;
      inset: 0;
      --mobile-rail-end: 100%;
    }

    .mobile-toc-track::before {
      content: '';
      position: absolute;
      right: 0;
      top: 0;
      width: 2px;
      height: var(--mobile-rail-end);
      background: var(--global-text-color);
      opacity: 0.45;
    }

    .mobile-toc-dots {
      position: absolute;
      inset: 0;
    }

    :global(.mobile-heading-dot) {
      position: absolute;
      right: 0;
      left: auto;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 50%;
      transform: translate(50%, -50%);
      background: var(--global-text-color);
      pointer-events: auto;
      touch-action: manipulation;
    }

    /* All headings currently visible in the viewport use the accent colour.
       This also makes the very small h4 markers clearly visible. */
    :global(.mobile-heading-dot.visible),
    :global(.mobile-heading-dot.active) {
      background: var(--global-theme-color);
    }

    /* Keep the topmost visible heading above overlapping markers. */
    :global(.mobile-heading-dot.active) {
      z-index: 2;
