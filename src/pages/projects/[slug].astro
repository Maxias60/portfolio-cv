---
import Giscus from '@components/Giscus.astro';
import ProjectToc from '@components/ProjectToc.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import { getAuthors, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import { getCollection, render } from 'astro:content';

import bibRaw from '../../data/papers.bib?raw';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: {
      slug: project.id,
    },

    props: {
      project,
    },
  }));
}

const { project } = Astro.props;

const { Content } = await render(project);

const {
  title,
  description,
  img,
  img_alt,
  hero_width,
  hero_max_height,
  url,
  github,
  giscus_comments,
  related_publications,
  redirect,
} = project.data;

/*
 * Redirect projects that point directly
 * to another website.
 */
if (redirect) {
  return Astro.redirect(redirect);
}

const githubUrl = github ? `https://github.com/${github}` : undefined;

/*
 * Generated OG image.
 */
const ogImagePath = img
  ? new URL(img, site.url).toString()
  : new URL(`${site.base}/og/project/${project.id}.png`, site.url).toString();

/*
 * Related publications.
 */
const allEntries = parseBibtex(bibRaw);

const relatedEntries =
  related_publications && related_publications.length > 0
    ? related_publications
        .map((key) => allEntries.find((entry) => entry.key === key))
        .filter(Boolean)
    : [];
---

<Page title={title} description={description} image={ogImagePath}>
  <div class="project-page-layout">
    <!-- Desktop TOC / Mobile progress rail -->
    <div class="project-toc-column">
      <ProjectToc title={title} />
    </div>

    <!-- Main project content -->
    <div class="post">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="breadcrumb-nav">
        <a href={`${site.base}/projects/`} class="breadcrumb-link"> ← Projects </a>
      </nav>

      <!-- Page header -->
      <header class="post-header">
        <h1 class="post-title" id="project-title">
          {title}
        </h1>

        {description && <p class="post-description">{description}</p>}

        <!-- External links -->
        {
          (githubUrl || url) && (
            <div class="project-links">
              {githubUrl && (
                <a
                  href={githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-btn project-btn--primary"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    width="16"
                    height="16"
                    aria-hidden="true"
                  >
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                  </svg>
                  GitHub
                </a>
              )}

              {url && url !== githubUrl && (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-btn project-btn--secondary"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    width="16"
                    height="16"
                    aria-hidden="true"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                  Website
                </a>
              )}
            </div>
          )
        }
      </header>

      <article>
        <!-- Hero image -->
        {
          img && (
            <div class="project-hero">
              <img
                src={withBase(img)}
                alt={img_alt ?? title}
                loading="eager"
                class="img-fluid z-depth-1 rounded"
                style={`max-width: ${hero_width}; max-height: ${hero_max_height ?? 'none'};`}
              />
            </div>
          )
        }

        <!-- Project MDX -->
        <div class="prose" id="project-content">
          <Content />
        </div>
      </article>

      <!-- References -->
      {
        relatedEntries.length > 0 && (
          <div class="references-section">
            <h2>References</h2>

            <div class="publications">
              <ol class="bibliography">
                {relatedEntries.map(
                  (entry) =>
                    entry && (
                      <li>
                        <span class="ref-authors">{getAuthors(entry)}</span>{' '}
                        <span class="ref-title">
                          {entry.fields.url ? (
                            <a href={entry.fields.url} target="_blank" rel="noopener noreferrer">
                              {getTitle(entry)}
                            </a>
                          ) : (
                            getTitle(entry)
                          )}
                        </span>
                        {'. '}
                        {getVenue(entry) && (
                          <span class="ref-venue">
                            <em>{getVenue(entry)}</em>

                            {getYear(entry) ? `, ${getYear(entry)}` : ''}

                            {'.'}
                          </span>
                        )}
                      </li>
                    ),
                )}
              </ol>
            </div>
          </div>
        )
      }

      <!-- Comments -->
      {giscus_comments && <Giscus />}
    </div>
  </div>
</Page>

<!-- =========================================================
     MEDIUM ZOOM
     ========================================================= -->

<script>
  import mediumZoom from 'medium-zoom';

  let zoom: ReturnType<typeof mediumZoom> | null = null;

  function initZoom() {
    zoom?.detach();

    zoom = null;

    const images = document.querySelectorAll<HTMLImageElement>(
      '#project-content img:not(.no-zoom)',
    );

    if (images.length === 0) {
      return;
    }

    zoom = mediumZoom(images, {
      background: 'rgba(0,0,0,0.7)',

      margin: 2,
    });

    zoom.on('open', (event: Event) => {
      const original = event.target as HTMLElement;

      let resolved = false;

      const markResolved = () => {
        resolved = true;
      };

      original.addEventListener('medium-zoom:opened', markResolved, {
        once: true,
      });

      setTimeout(() => {
        original.removeEventListener('medium-zoom:opened', markResolved);

        if (resolved) {
          return;
        }

        const clone = document.querySelector<HTMLElement>('.medium-zoom-image--opened');

        clone?.dispatchEvent(
          new TransitionEvent('transitionend', {
            bubbles: false,
            propertyName: 'transform',
            elapsedTime: 0.3,
          }),
        );
      }, 400);
    });
  }

  document.addEventListener('astro:page-load', initZoom);
</script>

<style>
  /* =========================================================
     PAGE LAYOUT
     ========================================================= */

  .project-page-layout {
    display: grid;

    /*
     * 240 px TOC
     * 40 px gap
     * original content width
     */
    grid-template-columns:
      240px
      minmax(0, 1fr);

    gap: 2.5rem;

    /*
     * Extend layout only to the left.
     *
     * Main project content therefore retains
     * its original width.
     */
    width: calc(100% + 280px);

    margin-left: -280px;

    align-items: start;
  }

  .post {
    width: 100%;

    min-width: 0;

    padding-top: 0;
  }

  /*
   * Desktop TOC follows the user while scrolling.
   */
  .project-toc-column {
    position: sticky;

    top: 5.5rem;

    align-self: start;

    width: 240px;

    max-height: calc(100vh - 7rem);

    overflow: visible;
  }

  /*
   * Narrow/mobile layout.
   *
   * Do NOT use display:none here.
   * ProjectToc contains the mobile rail.
   */
  @media (max-width: 1350px) {
    .project-page-layout {
      display: block;

      width: calc(100% + 0.2rem);

      margin-left: -0.2rem;
    }

    .project-toc-column {
      position: static;

      width: 0;
      height: 0;

      max-height: none;

      overflow: visible;
    }
  }

  /* =========================================================
     POST HEADER
     ========================================================= */

  .post-header {
    margin-bottom: 2rem;
  }

  .post-title {
    font-size: 2rem;

    font-weight: 700;

    color: var(--global-text-color);

    font-family: var(--font-sans);

    margin-bottom: 0.5rem;

    scroll-margin-top: 4.8rem;
  }

  .post-description {
    font-size: 1.1rem;

    color: var(--global-text-color-light);

    margin-bottom: 1rem;
  }

  /* =========================================================
     PROJECT LINKS
     ========================================================= */

  .project-links {
    display: flex;

    flex-wrap: wrap;

    gap: 0.75rem;

    margin-top: 1rem;
  }

  .project-btn {
    display: inline-flex;

    align-items: center;

    gap: 0.4rem;

    padding: 0.4rem 1rem;

    border-radius: 4px;

    font-size: 0.875rem;

    font-weight: 500;

    text-decoration: none;

    transition: opacity 0.15s ease;
  }

  .project-btn--primary {
    background-color: var(--global-theme-color);

    color: var(--global-hover-text-color);
  }

  .project-btn--primary:hover {
    opacity: 0.85;
  }

  .project-btn--secondary {
    background-color: transparent;

    color: var(--global-text-color);

    border: 1px solid var(--global-divider-color);

    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .project-btn--secondary:hover {
    border-color: var(--global-theme-color);

    color: var(--global-theme-color);
  }

  /* =========================================================
     HERO IMAGE
     ========================================================= */

  .project-hero {
    margin-bottom: 2rem;

    display: flex;

    justify-content: center;
  }

  .project-hero .img-fluid {
    width: auto;

    max-width: 500px;

    max-height: 650px;

    height: auto;

    display: block;

    object-fit: contain;
  }

  .rounded {
    border-radius: 4px;
  }

  .z-depth-1 {
    box-shadow:
      0 2px 5px 0 rgba(0, 0, 0, 0.16),
      0 2px 10px 0 rgba(0, 0, 0, 0.12);
  }

  /* =========================================================
     PROJECT MARKDOWN
     ========================================================= */

  #project-content :global(p) {
    margin-bottom: 1rem;
  }

  #project-content :global(ul) {
    list-style-type: disc;

    padding-left: 1.5rem;

    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  #project-content :global(ol) {
    list-style-type: decimal;

    padding-left: 1.5rem;

    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  #project-content :global(li) {
    margin-bottom: 0.25rem;
  }

  /* =========================================================
     HEADINGS
     ========================================================= */

  #project-content :global(h1),
  #project-content :global(h2),
  #project-content :global(h3),
  #project-content :global(h4) {
    scroll-margin-top: 4.8rem;
  }

  #project-content :global(h2) {
    font-size: 1.6rem;

    font-weight: 700;

    margin-top: 2rem;
    margin-bottom: 0.75rem;

    color: var(--global-theme-color);
  }

  #project-content :global(h3) {
    font-size: 1.25rem;

    font-weight: 600;

    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  #project-content :global(h4) {
    font-size: 1.05rem;

    font-weight: 600;

    margin-top: 1.25rem;
    margin-bottom: 0.4rem;
  }

  /* =========================================================
     REFERENCES
     ========================================================= */

  .references-section {
    margin-top: 3rem;

    padding-top: 1.5rem;

    border-top: 1px solid var(--global-divider-color);
  }

  .references-section h2 {
    font-size: 1.25rem;

    font-weight: 600;

    color: var(--global-text-color);

    margin-bottom: 1rem;

    font-family: var(--font-sans);
  }

  .bibliography {
    padding-left: 1.5rem;

    color: var(--global-text-color);

    font-size: 0.9rem;

    line-height: 1.7;
  }

  .bibliography li {
    margin-bottom: 0.75rem;
  }

  .ref-authors {
    color: var(--global-text-color-light);
  }

  .ref-title a {
    color: var(--global-theme-color);

    text-decoration: none;
  }

  .ref-title a:hover {
    text-decoration: underline;
  }

  .ref-venue {
    color: var(--global-text-color-light);
  }

  /* Mobile scroll offset override — must come after the desktop heading rules */
  @media (max-width: 1350px) {
    .post-title {
      scroll-margin-top: 4rem;
    }

    #project-content :global(h1),
    #project-content :global(h2),
    #project-content :global(h3),
    #project-content :global(h4) {
      scroll-margin-top: 4rem;
    }
  }

  :global(.medium-zoom-image--opened) {
    object-fit: contain !important;
    aspect-ratio: auto !important;
    height: auto !important;
  }
</style>
